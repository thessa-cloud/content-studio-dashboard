# ──────────────────────────────────────────────────────────────────────────
# Content Studio Dashboard — environment variables
# ──────────────────────────────────────────────────────────────────────────
# Copy this file to `.env.local` for local dev. On Vercel, paste these into
# Project Settings → Environment Variables. The dashboard reads each one at
# runtime, missing keys fall through to clean empty-state UI so you can
# still see the dashboard before everything is wired.
# ──────────────────────────────────────────────────────────────────────────

# Supabase (required for any data to load)
#   Find both in Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...service-role-key...

# Scraper Edge Function (required for the [Scrape now] button)
#   Set this to any long random string. Use the SAME value in your
#   Supabase Edge Function (`content-scraper`) as the bearer token check.
FUNCTION_SECRET=replace-me-with-a-long-random-string

# Apify (Instagram scraper, set inside the Edge Function — NOT here)
# APIFY_TOKEN=apify_api_...
